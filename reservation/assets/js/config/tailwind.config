// Configuration personnalisée de Tailwind CSS (palette océan et typographie)
tailwind.config = {
    theme: {
        extend: {
            fontFamily: {
                sans: ['Inter', 'sans-serif'],
            },
            colors: {
                ocean: {
                    950: '#020c1b',
                    900: '#041730',
                    850: '#051c3d',
                    800: '#072850',
                    700: '#073561',
                    600: '#0b467d',
                    500: '#0e5b9e',
                    400: '#1480da',
                    300: '#38bdf8',
                }
            }
        }
    }
};